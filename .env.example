# 藏泽（Cangze）环境配置示例

# 服务端口
PORT=3000

# Home Assistant 配置
# Home Assistant 实例地址（如 http://192.168.1.100:8123 或 http://homeassistant:8123）
HA_URL=http://homeassistant:8123
# Home Assistant 长期访问令牌 (Long-Lived Access Token)
HA_TOKEN=your_home_assistant_long_lived_token_here

# 大语言模型 API 配置
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
