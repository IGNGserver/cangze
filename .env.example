# 藏泽（Cangze）部署配置示例。复制为 .env 后按需修改；全部可选。
# 大模型与 Home Assistant 的连接信息在网页的「设置」里配置，并以加密形式保存在数据卷中，不写在这里。

# 镜像版本（建议固定为具体版本号，例如 0.1.0）
CANGZE_VERSION=latest

# 对外端口与监听地址。只想本机访问可改为 127.0.0.1
CANGZE_PORT=8080
CANGZE_BIND=0.0.0.0

# 通过域名访问时填写（启用 https profile 时必填），例如 https://home.example.com
CANGZE_PUBLIC_ORIGIN=
# https profile 使用的域名，例如 home.example.com
CANGZE_DOMAIN=
# 反向代理网段（https profile 下填 172.16.0.0/12）
CANGZE_TRUSTED_PROXIES=
# 额外允许的 Host 名（逗号分隔），例如 hub.lan
CANGZE_ALLOWED_HOSTS=

# 主密钥（Base64 编码的 32 字节）。留空时首次启动会在数据卷生成 master.key。
# 自行管理主密钥时，备份数据卷不再等于备份全部凭据。
CANGZE_MASTER_KEY=

CANGZE_LOG_LEVEL=info
