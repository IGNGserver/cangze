{
  "openapi": "3.1.0",
  "info": {
    "title": "Cangze API",
    "version": "0.1.0",
    "description": "REST API of the Cangze hub. Live updates are delivered over the /api/v1/stream WebSocket.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "paths": {
    "/api/v1/system/info": {
      "get": {
        "summary": "Public system information",
        "tags": [
          "system"
        ],
        "operationId": "getApiV1SystemInfo",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "cangze"
                    },
                    "version": {
                      "type": "string"
                    },
                    "apiVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "setupRequired": {
                      "type": "boolean"
                    },
                    "node": {
                      "type": "string"
                    },
                    "startedAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "apiVersion",
                    "setupRequired",
                    "node",
                    "startedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "system"
        ],
        "operationId": "getHealthLive",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness probe",
        "tags": [
          "system"
        ],
        "operationId": "getHealthReady",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded",
                        "starting"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "checks": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "ok",
                          "fail",
                          "skip"
                        ]
                      }
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "checks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cangze_session"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Device token"
      }
    }
  }
}
